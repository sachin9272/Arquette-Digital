# Server Port (for local development)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI (required for serverless & local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pralash-clinic?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pralash-clinic?retryWrites=true&w=majority

# CORS Allowed Client Domains (URLs of your deployed Vercel apps)
FRONTEND_URL=https://your-frontend-app.vercel.app
ADMIN_URL=https://your-admin-app.vercel.app

# SMTP Credentials for Booking Confirmation Emails
SMPT_MAIL=your-email@gmail.com
SMPT_PASSWORD=your-16-character-gmail-app-password

# Cloudinary Storage for Doctor Profile Images
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
